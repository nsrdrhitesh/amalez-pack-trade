# TEMPLATE ONLY. Set up the real .env outside the web root on the server.
# Never replace an existing production key or secrets during redeployment.
APP_NAME="Amalez PackTrade"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://amalezpacktrade.com
COMPANY_NAME="Amalez PackTrade"
COMPANY_SITE_INDEXABLE=false

# No MySQL needed while the database-dependent admin module is disabled.
ADMIN_ENABLED=false
ADMIN_REGISTRATION_ENABLED=false
CMS_ENABLED=false
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
FILESYSTEM_DISK=local
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
